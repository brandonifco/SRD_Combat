!client/assets/sprites/Berserker/
!client/assets/sprites/Black_Bear/
!client/assets/sprites/Black_Dragon_Wyrmling/
!client/assets/sprites/Brown_Bear/
!client/assets/sprites/Bugbear/
!client/assets/sprites/Dire_Wolf/
!client/assets/sprites/Fighter_Drawn/
